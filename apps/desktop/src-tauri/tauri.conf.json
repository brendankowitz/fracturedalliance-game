{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fractured Alliance",
  "version": "0.0.1",
  "identifier": "au.com.fracturedalliance.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "pnpm -F @fa/web dev",
    "beforeBuildCommand": "pnpm -F @fa/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fractured Alliance",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  },
  "plugins": {
    "fs": {
      "scope": {
        "allow": ["$DOCUMENT/FracturedAlliance/**"]
      }
    }
  }
}
